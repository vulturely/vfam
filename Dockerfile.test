FROM node:24-bookworm AS node

FROM rust:1-bookworm

COPY --from=node /usr/local/ /usr/local/

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    dbus \
    dbus-x11 \
    file \
    gnome-keyring \
    libayatana-appindicator3-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libjavascriptcoregtk-4.1-dev \
    librsvg2-dev \
    libsoup-3.0-dev \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    libxdo-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy rustfmt llvm-tools-preview \
    && cargo install cargo-llvm-cov --locked

WORKDIR /app

COPY package.json package-lock.json ./
RUN HUSKY=0 npm ci
RUN npx playwright install --with-deps chromium webkit

COPY . .

ENV CI=true

# OS credential store tests need an unlocked Secret Service on a D-Bus session.
CMD ["dbus-run-session", "--", "bash", "-c", "echo -n vfam-test | gnome-keyring-daemon --unlock --components=secrets >/dev/null && npm run lint && npm run format:check && npm run check && npm test && npm run check:rust"]
