{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "VFAM",
	"version": "0.1.0",
	"identifier": "com.swavan.vfam",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"beforeBundleCommand": "node scripts/check-macos-signing.mjs",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "VFAM",
				"width": 1280,
				"height": 800
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "Entitlements.plist"
		},
		"iOS": {
			"minimumSystemVersion": "15.0"
		}
	}
}
