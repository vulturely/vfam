{
	"name": "vfam",
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"workspaces": [
		"packages/*",
		"plugins/*"
	],
	"overrides": {
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"format:rust": "cargo fmt --all",
		"check:rust": "node scripts/check-rust-architecture.mjs && cargo fmt --all -- --check && cargo clippy --workspace --all-targets --all-features -- -D warnings",
		"test": "npm run test:ui && npm run test:backend",
		"test:ui": "node scripts/test-ui.mjs",
		"test:unit": "vitest run --coverage",
		"test:unit:raw": "vitest run --coverage --coverage.reporter=json --coverage.reporter=text --coverage.reportsDirectory=coverage/unit --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0",
		"test:backend": "cargo llvm-cov --workspace --ignore-filename-regex 'src/app\\.rs$' --fail-under-lines 90 -- --include-ignored",
		"test:integration": "playwright test",
		"tauri": "tauri"
	},
	"license": "MIT",
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-code-block": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@vulture/core": "0.1.0",
		"@vulture/plugin-identity": "0.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/roboto": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/istanbul-lib-coverage": "^2.0.6",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^5.0.5",
		"ast-v8-to-istanbul": "^1.0.7",
		"cn": "^0.5.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.2.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"remixicon-svelte": "^0.0.5",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.0.16",
		"vitest": "^5.0.5"
	}
}
